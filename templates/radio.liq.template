name="${STATION_NAME}"
description="${STATION_DESCRIPTION}"
genre="${STATION_GENRE}"
%include "/etc/liquidsoap/users.liq"
def auth(login)= if list.assoc(login.user,users)==login.password then true else false end end
live=input.harbor("live",icy=true,port=${LIVE_PORT},auth=auth)
files=mksafe(playlist(mode="randomize",reload=1,reload_mode="rounds","${MUSIC_DIR}"))
out=fallback(track_sensitive=false,[live,files])
output.icecast(%mp3(bitrate=128),mount="/radio-128.mp3",host="localhost",port=${ICECAST_PORT},password="${SOURCE_PW}",out)
output.icecast(%mp3(bitrate=${BITRATE}),mount="/radio-320.mp3",host="localhost",port=${ICECAST_PORT},password="${SOURCE_PW}",out)
output.shoutcast(%mp3(bitrate=${BITRATE}),host="localhost",port=${SHOUTCAST_PORT},password="${SOURCE_PW}",out)
